<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:FleetManager.Models"
             x:Class="FleetManager.Views.VehicleItemView"
             x:DataType="models:Vehicle">

    <Border Margin="10"
            Padding="15"
            Background="#2b2b2b"
            CornerRadius="8"
            BoxShadow="0 4 10 0 #40000000"
            Width="250">

        <StackPanel Spacing="10">
            <DockPanel>
                <TextBlock Text="{Binding Name}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding RegistrationNumber}"
                           FontSize="11"
                           Foreground="Gray"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Separator Background="#444" Height="1"/>

            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Poziom paliwa:" FontSize="12" Foreground="#bbb"/>
                    <TextBlock Text="{Binding FuelLevel, StringFormat={}{0}%}"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               FontWeight="Bold"
                               Foreground="{Binding FuelColor}"/>
                </DockPanel>

                <ProgressBar Value="{Binding FuelLevel}"
                             Height="10"
                             Margin="0,5,0,0"
                             Foreground="{Binding FuelColor}"
                             Background="#444"
                             CornerRadius="5"/>

                <TextBlock Text="Za malo paliwa na trase!"
                           Foreground="#dc3545"
                           FontSize="10"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding CanShowLowFuelWarning}"/>
            </StackPanel>

            <DockPanel Margin="0,5,0,0">
                <Border Padding="8,4"
                        CornerRadius="4"
                        Background="{Binding StatusColor}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Status}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                    <Button Content="Tankuj"
                            Click="RefuelButton_OnClick"
                            IsEnabled="{Binding CanRefuel}"
                            FontSize="11"
                            Padding="10,2"/>

                    <Button Content="W trase"
                            Click="DispatchButton_OnClick"
                            IsEnabled="{Binding CanGoOnRoute}"
                            Background="#007ACC"
                            FontSize="11"
                            Padding="10,2"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
