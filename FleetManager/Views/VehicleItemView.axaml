<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FleetManager.ViewModels"
             xmlns:models="using:FleetManager.Models"
             x:Class="FleetManager.Views.VehicleItemView"
             x:DataType="models:Vehicle">

	<Border Margin="10"
			Padding="15"
			Background="#2b2b2b"
			CornerRadius="8"
			BoxShadow="0 4 10 0 #40000000">

		<StackPanel Spacing="10">
			<DockPanel>
				<TextBlock Text="{Binding Name}"
						   FontSize="18"
						   FontWeight="Bold"
						   Foreground="White"/>
				<TextBlock Text="{Binding RegistrationNumber}"
						   FontSize="12"
						   Foreground="Gray"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"/>
			</DockPanel>

			<Separator Background="#444"/>

			<StackPanel>
				<DockPanel>
					<TextBlock Text="Fuel Level:" FontSize="12" Foreground="#bbb"/>
					<TextBlock Text="{Binding FuelLevel, StringFormat={}{0}%}"
							   FontSize="12"
							   HorizontalAlignment="Right"
							   FontWeight="Bold"/>
				</DockPanel>
				<ProgressBar Value="{Binding FuelLevel}"
							 Height="10"
							 Margin="0,5,0,0"
							 />
			</StackPanel>

			<DockPanel Margin="0,5,0,0">
				<Border Padding="8,4"
						CornerRadius="4"
						>
					<TextBlock Text="{Binding Status}"
							   FontSize="11"
							   FontWeight="SemiBold"
							   Foreground="White"/>
				</Border>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
					<Button Content="Refuel"
							
							CommandParameter="{Binding}"
							FontSize="11"/>
					<Button Content="Dispatch"
							
							CommandParameter="{Binding}"
							FontSize="11"
							Background="#007ACC"/>
				</StackPanel>
			</DockPanel>
		</StackPanel>
	</Border>
</UserControl>
