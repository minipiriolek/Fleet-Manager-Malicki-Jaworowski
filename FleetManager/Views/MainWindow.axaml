<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:FleetManager.Models"
        xmlns:vm="using:FleetManager.ViewModels"
        xmlns:views="using:FleetManager.Views"
        x:Class="FleetManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SwiftTrans Fleet Manager"
        Background="#1e1e1e"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2d2d2d" Padding="15">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="SWIFTTRANS FLEET"
                           FontSize="20"
                           FontWeight="Black"
                           Foreground="#007ACC"
                           VerticalAlignment="Center"/>
                <TextBlock Text="v1.0"
                           Foreground="Gray"
                           VerticalAlignment="Bottom"
                           FontSize="12"
                           Margin="0,0,0,2"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#dc3545"
                Padding="15,10"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Vehicles}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Vehicle">
                        <views:VehicleItemView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
